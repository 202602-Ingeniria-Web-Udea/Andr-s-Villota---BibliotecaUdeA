# Supabase: URL del pooler en modo sesión para ejecución (o conexión directa si soporta IPv4)
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:5432/postgres?sslmode=require"
# Conexión directa de Supabase para migraciones Prisma (puede requerir IPv6)
DIRECT_URL="postgresql://USUARIO:CLAVE@HOST:5432/postgres?sslmode=require"
# Generar una clave aleatoria de al menos 32 caracteres; no subir .env a GitHub
AUTH_SECRET="CAMBIA_ESTO_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES"
SEED_ADMIN_EMAIL="admin@biblioteca.test"
SEED_ADMIN_PASSWORD="CAMBIA_CONTRASENA_ADMIN"
SEED_USER_EMAIL="usuario@biblioteca.test"
SEED_USER_PASSWORD="CAMBIA_CONTRASENA_USER"
